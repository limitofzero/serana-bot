# Copy to .env and fill in. `.env` is gitignored.

# --- Model backend (any OpenAI-compatible endpoint) ---
SERANA_API_KEY=
SERANA_BASE_URL=https://api.openai.com/v1
SERANA_MODEL=gpt-5

# Optional: sampling temperature. Leave empty unless you know your model accepts one —
# reasoning models (the gpt-5 family) reject every value but their own default and fail
# the whole request, so nothing is sent when this is unset.
SERANA_TEMPERATURE=

# Optional: a smaller, cheaper model for side work nobody reads — today, the summary a
# conversation is folded into when it is compacted. Falls back to SERANA_MODEL when unset.
SERANA_AUXILIARY_MODEL=

# --- Telegram frontend ---
# From @BotFather. Only needed for the serana-tg service.
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ids allowed to talk to the bot, comma separated. These are user
# ids (always positive), not group or channel chat ids: the bot only answers commands in a
# private chat with it, so a group id here could never match anyway.
# Leave empty and the bot answers nobody — this is deliberate.
SERANA_ALLOWED_USER_IDS=

# --- Terminal REPL (the `serana` binary) ---
# Your numeric Telegram user id. Reminders created in the REPL are owned by it, so the
# bot delivers them to your phone. The REPL itself never delivers anything.
SERANA_USER_ID=

# --- Scheduling ---
# IANA time zone every new reminder is created in. "20th at 10:00" means 10:00 here.
SERANA_TIMEZONE=Asia/Tbilisi
# How often the scheduler looks for due reminders, in seconds.
SERANA_TICK_SECONDS=60

# --- Google Calendar (optional) ---
# Leave all three empty and serana simply has no calendar: it will say so rather than
# reporting an outage. Fill them in and /calendar can read your events, book appointments,
# cancel an occurrence, decline an invitation and delete an event.
#
# Getting them, once:
#   1. console.cloud.google.com -> new project -> enable the Google Calendar API
#   2. OAuth consent screen -> External -> add the scope below -> PUBLISH THE APP
#      (an app left in "Testing" issues refresh tokens that expire after 7 days)
#   3. Credentials -> OAuth client ID -> type "Desktop app" -> copy the id and secret
#   4. python3 scripts/google-oauth.py   — opens a browser once and prints these three lines
#
# Scope used: https://www.googleapis.com/auth/calendar.events  (read and write on events)
SERANA_GOOGLE_CLIENT_ID=
SERANA_GOOGLE_CLIENT_SECRET=
SERANA_GOOGLE_REFRESH_TOKEN=

# Which calendar to use. "primary" is the one attached to the account above.
SERANA_GOOGLE_CALENDAR_ID=primary

# Minutes reserved either side of an appointment that needs travelling to, so the block on
# the calendar covers the journey and "am I free then?" answers correctly. Anything online
# reserves nothing extra, and saying how far it is overrides this for that appointment.
SERANA_TRAVEL_MINUTES=30

# --- Crypto price digest ---
# The watchlist a digest STARTS with, the first time you use /prices. After that the digest
# keeps its own list, edited by asking: "/prices add 1inch", "/prices remove ETH" — changing
# this variable does not touch a digest that already exists. CoinGecko ids, comma-separated
# (the "API ID" on the asset's coingecko.com page). The daily send is 09:00 in
# SERANA_TIMEZONE until you move it ("/prices send it at 8").
SERANA_PRICE_ASSETS=bitcoin,ethereum,cow-protocol

# Optional. Leave empty for CoinGecko's keyless route, which is enough for a daily digest
# but shares a rate limit with everyone on the same IP. A free Demo key (coingecko.com ->
# Developer Dashboard) lifts that. If CoinGecko fails either way, DefiLlama answers instead
# — prices only, without the 24-hour move.
SERANA_COINGECKO_API_KEY=

# --- Runtime ---
RUST_LOG=info
